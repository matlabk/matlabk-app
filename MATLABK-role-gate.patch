+// 12) admin / fail-closed
+test('12a. لا يوجد اختيار admin: loginGoogle("admin") لا يفتح Google ولا يفترض عميلًا', async () => {
+  A.openRolePick(); window.selectedType = null; popupSucceeds(USER); await A.loginGoogle('admin');
