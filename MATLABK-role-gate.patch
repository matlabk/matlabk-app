+  const p1 = A.loginGoogle(); const p2 = A.loginGoogle(); await p2; assert.equal(t.popupCalls, 1); assert.equal($('lg-google').disabled, true);
+  done({ user: USER }); t.currentUser = USER; await p1;
+});
