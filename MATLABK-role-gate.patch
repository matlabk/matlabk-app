+const T = () => globalThis.__t;
+export const auth = { get currentUser() { return T().currentUser; } };
+export const db = {}; export const gProvider = {};
+export const doc = (_d, col, id) => ({ col, id });
+const tbl = (col) => (col === 'users' ? T().users : T().stores);
+export const getDoc = async (ref) => {
+  T().reads.push(ref.col + '/' + ref.id);
+  if (T().readGate) await T().readGate;
+  if (T().failRead) throw Object.assign(new Error('unavailable'), { code: 'unavailable' });
+  const d = tbl(ref.col)[ref.id]; return { exists: () => d !== undefined, data: () => d };
+};
+export const setDoc = async (ref, data) => { T().writes.push({ op: 'set', path: ref.col + '/' + ref.id, data }); tbl(ref.col)[ref.id] = data; };
+export const updateDoc = async (ref, data) => { T().writes.push({ op: 'update', path: ref.col + '/' + ref.id, data }); };
+export const runTransaction = async (_d, fn) => fn({ set: (ref, data) => setDoc(ref, data), update: (ref, data) => updateDoc(ref, data), get: async (ref) => getDoc(ref) });
+export const serverTimestamp = () => 'TS';
+export const signInWithPopup = async () => { T().popupCalls++; return T().popup(); };
+export const signInWithRedirect = async () => { T().redirectCalls++; };
+export const signOut = async () => { T().currentUser = null; T().signOuts++; };
