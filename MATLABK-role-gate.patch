+// بيئة المتصفح المحاكاة + حالة Firebase المحاكاة. كل اختبار يبدأ من reset() نظيف.
+import { register } from 'node:module';
+register('./loader.mjs', import.meta.url);
+
+const realSetTimeout = globalThis.setTimeout;
+globalThis.setTimeout = (f, ms, ...a) => { const t = realSetTimeout(f, ms, ...a); t?.unref?.(); return t; };
+globalThis.fetch = async () => ({ ok: true });
+
+const els = new Map();
+function el(id) {
+  if (!els.has(id)) els.set(id, { id, style: {}, hidden: false, disabled: false, textContent: '', attrs: {}, classes: new Set(),
+    classList: { add(c) { els.get(id).classes.add(c); }, remove(c) { els.get(id).classes.delete(c); }, toggle(c, on) { on ? els.get(id).classes.add(c) : els.get(id).classes.delete(c); }, contains(c) { return els.get(id).classes.has(c); } },
+    setAttribute(k, v) { els.get(id).attrs[k] = v; }, getAttribute(k) { return els.get(id).attrs[k]; } });
+  return els.get(id);
+}
+globalThis.document = { getElementById: el, querySelectorAll: () => [] };
+globalThis.window = globalThis; globalThis.addEventListener = () => {};
+const store = () => { let m = new Map(); return { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => { if (store.broken) throw new Error('blocked'); m.set(k, String(v)); }, removeItem: (k) => m.delete(k), clear: () => m.clear() }; };
+globalThis.sessionStorage = store(); globalThis.localStorage = store();
+
+export const $ = (id) => el(id);
+export function reset() {
+  els.clear(); sessionStorage.clear(); localStorage.clear(); store.broken = false;
+  globalThis.__t = { users: {}, stores: {}, reads: [], writes: [], calls: [], screens: [], signOuts: 0, popupCalls: 0, redirectCalls: 0, failRead: false, currentUser: null, popup: null };
+  globalThis.CU = null; globalThis.CUD = null; globalThis.selectedType = null;
+  if (typeof A !== 'undefined') { A.resetLoginState(); A.clearEntryIntent(); A.clearRedirectPending(); } // حالة الموديول (القفل/الاختيار) لا تتسرب بين الاختبارات
+  return globalThis.__t;
+}
+export const T = () => globalThis.__t;
+export const breakSessionStorage = (on) => { store.broken = on; };
+
+const A = await import('../../js/auth.js');
+export { A };
+// نفس تسلسل main.js في onAuthStateChanged(user) - يتأكد منه اختبار عقد ثابت أنه مطابق للمصدر.
+export async function authStateChanged(user) {
+  T().currentUser = user;
+  const attempt = A.captureLoginIntent();
+  A.resetLoginState(); A.clearRedirectPending();
+  window.CUD = null; window.CU = user;
+  await A.handleSignedIn(user, attempt);
+}
+// popup يكتمل بنجاح للمستخدم المحدد ثم يطلق authStateChanged كما يفعل SDK (إلا لو كان نفس المستخدم داخلًا بالفعل).
+export function popupSucceeds(user) {
+  T().popup = async () => { const already = T().currentUser && T().currentUser.uid === user.uid; T().currentUser = user; if (!already) queueMicrotask(() => authStateChanged(user)); return { user }; };
+}
+export const settle = () => new Promise((r) => realSetTimeout(r, 15));
+export const DASHBOARDS = ['screen-customer', 'screen-driver', 'screen-merchant', 'screen-admin'];
+export const opened = (...ids) => ids.some((i) => T().screens.includes(i));
