@@ -0,0 +1,8 @@
+// loader: يحوّل استيرادات js/auth.js (Firebase + باقي الموديولات الثقيلة) إلى stubs محلية، فيتشغّل كود auth.js الحقيقي في Node.
+const STUBS = new URL('../stubs/', import.meta.url);
+const MAP = new Set(['firebase', 'utils', 'customer', 'driver', 'admin', 'notifications', 'merchant', 'orders', 'rides']);
+export async function resolve(specifier, context, next) {
+  const m = /^\.\/([a-z]+)\.js$/.exec(specifier);
+  if (m && MAP.has(m[1]) && /\/js\/auth\.js$/.test(context.parentURL || '')) return { url: new URL(m[1] + '.mjs', STUBS).href, shortCircuit: true };
+  return next(specifier, context);
+}
