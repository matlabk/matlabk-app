+  const r = run({ storage: { matlabk_entry_type: recent }, session: { uid: 'u1', email: 'a@x.com' }, users: { u1: CUST } });
+  assert.deepEqual(r.screens, ['screen-customer'], JSON.stringify(r)); assert.equal(r.signOuts, 0); assert.equal(r.err, '');
+});
