+// node --test tests/auth-e2e.test.mjs
+// تشغيل كامل للتطبيق (js/main.js + كل الموديولات الحقيقية + DOM مبني من index.html الحقيقي): الضغط يتم بتنفيذ معالجات onclick/onsubmit
