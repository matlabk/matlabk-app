+  choose('customer'); fire('em-forgot'); type('fg-email', 'bad'); fire('fg-form', 'submit'); await sleep(20); assert.match(el('fg-err').textContent, /صيغة البريد/); assert.equal(S.calls.includes('reset'), false);
