 export const signInWithPopup = async () => { T().popupCalls++; return T().popup(); };
 export const signInWithRedirect = async () => { T().redirectCalls++; };
 export const signOut = async () => { T().currentUser = null; T().signOuts++; };
+// ===== البريد وكلمة المرور (محاكاة تحكّمها الاختبارات عبر T().emailAuth) =====
+// T().accounts: { 'a@x.com': { uid, password } } - المحاكاة تتبع سلوك Firebase: email-already-in-use / invalid-credential / weak-password / invalid-email
+const fbErr = (code) => Object.assign(new Error(code), { code });
+const fire = (u) => { T().currentUser = u; if (T().onAuth) queueMicrotask(() => T().onAuth(u)); return { user: u }; };
+export const signInWithEmailAndPassword = async (_a, email, password) => {
+  T().emailCalls.push({ op: 'signIn', email }); if (T().netFail) throw fbErr('auth/network-request-failed');
+  const a = T().accounts[email]; if (!a || a.password !== password) throw fbErr('auth/invalid-credential');
+  return fire({ uid: a.uid, email });
+};
+export const createUserWithEmailAndPassword = async (_a, email, password) => {
+  T().emailCalls.push({ op: 'create', email }); if (T().netFail) throw fbErr('auth/network-request-failed');
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) throw fbErr('auth/invalid-email');
+  if (password.length < 6) throw fbErr('auth/weak-password');
+  if (T().accounts[email]) throw fbErr('auth/email-already-in-use');
+  const a = { uid: 'uid-' + email, password }; T().accounts[email] = a; return fire({ uid: a.uid, email });
+};
+export const sendPasswordResetEmail = async (_a, email) => {
+  T().emailCalls.push({ op: 'reset', email }); if (T().netFail) throw fbErr('auth/network-request-failed');
+  if (T().resetErr) throw fbErr(T().resetErr);
+  if (!T().accounts[email]) throw fbErr('auth/user-not-found');
+};
